% ============================================================
% labstyle.sty
% CSMC204 Laboratory File Style
%
% Compile with LuaLaTeX
%
% Project structure:
%
% .
% ├── fonts/
% │   ├── cour.ttf
% │   ├── courbd.ttf
% │   ├── couri.ttf
% │   ├── courbi.ttf
% │   ├── times.ttf
% │   ├── timesbd.ttf
% │   ├── timesi.ttf
% │   └── timesbi.ttf
% ├── images/
% │   ├── OOP/
% │   └── OS/
% ├── labstyle.sty
% ├── OOP.tex
% └── OS.tex
%
% ============================================================


\NeedsTeXFormat{LaTeX2e}

\ProvidesPackage{labstyle}[
    2026/09/01
    CSMC204 Laboratory File Style
]


% ============================================================
% PACKAGES
% ============================================================

\RequirePackage{fontspec}

\RequirePackage[
    letterpaper,
    left=1in,
    right=1in,
    top=1in,
    bottom=1in,
    headheight=17pt,
    headsep=0.5in,
    footskip=0.5in
]{geometry}

\RequirePackage{fancyhdr}

\RequirePackage{graphicx}

\RequirePackage{xparse}

\RequirePackage{needspace}

\RequirePackage{xcolor}

\RequirePackage{listings}

% ============================================================
% FONTS
% ============================================================

% Main document font
\setmainfont[
    Path=fonts/,
    UprightFont=times.ttf,
    BoldFont=timesbd.ttf,
    ItalicFont=timesi.ttf,
    BoldItalicFont=timesbi.ttf
]{times.ttf}


% Code font
\setmonofont[
    Path=fonts/,
    UprightFont=cour.ttf,
    BoldFont=courbd.ttf,
    ItalicFont=couri.ttf,
    BoldItalicFont=courbi.ttf
]{cour.ttf}


% ============================================================
% PAGE GEOMETRY
% ============================================================

% US Letter:
%
%   8.5 x 11 inches
%
% 1 inch margins on all sides.


% ============================================================
% DEFAULT TEXT
% ============================================================

\AtBeginDocument{

    % 14 pt Times New Roman
    \fontsize{14pt}{16pt}\selectfont

    % No first-line indentation
    \setlength{\parindent}{0pt}

    % Paragraph spacing
    \setlength{\parskip}{8pt}
}


% ============================================================
% FOOTER
% ============================================================

% Subject code command (default: CSMCXXXX)
\newcommand{\subjectcode}{CSMCXXXX}

\pagestyle{fancy}

\fancyhf{}

\fancyfoot[L]{\subjectcode}

\fancyfoot[C]{\thepage}

\fancyfoot[R]{25BTCS006}

\renewcommand{\headrulewidth}{0pt}

\renewcommand{\footrulewidth}{0pt}

\setlength{\footskip}{0.5in}


% ============================================================
% ASSIGNMENT TITLE
% ============================================================

% Usage:
%
% \assignmenttitle
%     {LAB ASSIGNMENT 1}
%     {BASICS REVISION}

\NewDocumentCommand{\assignmenttitle}{m m}
{
    \begin{center}

        \textbf{#1}\\[10pt]
        \textbf{#2}
        \vspace{15pt}
    \end{center}
}


% ============================================================
% AIM
% ============================================================

% Usage:
%
% \aim{
%     To write simple programs for revising basic C/C++ concepts.
% }

\NewDocumentCommand{\aim}{m}
{
    \textbf{Aim:} #1
    \par
    \vspace{15pt}
}

% ============================================================
% APPARATUS
% ============================================================

% Usage:
%
% \appr{
%     Computer System, USB Drive
% }

\NewDocumentCommand{\appr}{m}
{
    \textbf{Apparatus Required:} #1
    \par
    \vspace{15pt}
}

% ============================================================
% PROGRAMS
% ============================================================

% Usage:
%
% \programs

\newcommand{\programs}
{
    \textbf{Programs:}
    \par
    \vspace{15pt}
}


% ============================================================
% PROGRAM DESCRIPTION
% ============================================================

% Usage:
%
% \program{
%     Write a program to rotate a matrix 90 degrees clockwise in C++.
% }

\NewDocumentCommand{\program}{m}
{
    \needspace{3\baselineskip}
    \textbf{#1}
    \par
    \vspace{10pt}
}


% ============================================================
% CODE LABEL
% ============================================================

% Usage:
%
% \codelabel

\newcommand{\codelabel}
{
    \textbf{Code:}
    \vspace{15pt}
    \par
}


% ============================================================
% CODE BLOCK
% ============================================================
%
% The original Word document uses:
%
%   Font       : Courier New
%   Size       : 12 pt
%   Background : White
%   Border     : Black
%   Border     : Thin
%
% listings is used here instead of tcolorbox.
%
% This is deliberately simple and robust.
%
% ============================================================


\lstdefinestyle{labcode}{%
    basicstyle=\ttfamily\fontsize{12pt}{16pt}\selectfont,%
    % No syntax highlighting
    keywordstyle={},%
    commentstyle={},%
    stringstyle={},%
    % White background
    backgroundcolor=\color{white},%
    % Thin black border
    frame=single,%
    rulecolor=\color{black},%
    framerule=0.5pt,%
    % No line numbers
    numbers=none,%
    % Preserve spaces
    keepspaces=true,%
    % Allow long source lines to wrap
    breaklines=true,%
    breakatwhitespace=false,%
    % Use the full available width
    columns=fullflexible,%
    % Keep indentation
    showstringspaces=false,%
    % Don't add extra vertical margins
    aboveskip=0pt,%
    belowskip=0pt,%
    % Small internal margins
    xleftmargin=0pt,%
    xrightmargin=0pt,%
    % Don't insert captions
    captionpos=b%
}


% Code environment
%
% Usage:
%
% \begin{code}
% #include <iostream>
% using namespace std;
%
% int main() {
%     return 0;
% }
% \end{code}

\lstnewenvironment{code}
{
    \lstset{style=labcode}
}
{}


% ============================================================
% OUTPUT LABEL
% ============================================================

% Usage:
%
% \outputlabel

\newcommand{\outputlabel}
{
    \needspace{3\baselineskip}
    \textbf{Output:}
    \par
}


% ============================================================
% OUTPUT IMAGE
% ============================================================

% Usage:
%
% \outputimage{images/OOP/output01.png}
%
% Optional width:
%
% \outputimage[0.60\linewidth]{images/OOP/output01.png}

\NewDocumentCommand{\outputimage}{O{0.75\linewidth} m}
{
    \begin{center}

        \includegraphics[
            width=#1
        ]{#2}

    \end{center}
}

% ============================================================
% CONCLUSION
% ============================================================

% Usage:
%
% \concl{
%     Programs were written successfully.
% }

\NewDocumentCommand{\concl}{m}
{
    \vspace{30pt}
    \textbf{Conclusion:} #1
    \par
    \vspace{15pt}
    \newpage
}

% ============================================================
% RESULT
% ============================================================

% Usage:
%
% \resul{
%     Programs were written successfully.
% }

\NewDocumentCommand{\resul}{m}
{
    \textbf{Result:} #1
    \par
    \vspace{15pt}
}


% ============================================================
% GENERIC BOLD LABEL
% ============================================================

% Usage:
%
% \sectionlabel{Result:}

\NewDocumentCommand{\sectionlabel}{m}
{
    \textbf{#1}
    \par
}


% ============================================================
% END
% ============================================================

\endinput
